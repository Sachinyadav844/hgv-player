# Copy this file to backend/.env.test and set a URI for a MongoDB cluster you control.
# Never use the production hgv_player_db URI here. Tests create and drop hgv_test_* databases.
# TEST_MONGODB_URI must be set explicitly; MONGODB_URI is never used by the test suites.
TEST_MONGODB_URI=

# Optional comma-separated DNS server IPs for MongoDB SRV lookups.
# MONGODB_DNS_SERVERS=
