# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

NODE_ENV=development
PORT=4000

# MongoDB connection string. Local example: mongodb://127.0.0.1:27017/hgv_player_db
# MongoDB Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hgv_player_db?retryWrites=true&w=majority
# This value stays on the backend. It must never be put in frontend environment variables.
MONGODB_URI=

# Optional comma-separated DNS server IPs used by Node.js before MongoDB connects.
# This overrides OS DNS for all lookups in this backend process. Leave unset unless needed;
# use only resolvers permitted by your network/deployment policy.
# MONGODB_DNS_SERVERS=

# Secret used to sign login cookies. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public URL(s) of the frontend, comma-separated, no trailing slash. Used for CORS, the
# WebSocket origin check, CSRF checks and invite links.
#   Development: http://localhost:5173
#   Production:  https://your-frontend.example.com
CLIENT_ORIGIN=http://localhost:5173

# --- Optional -------------------------------------------------------------------------------
# Cookie settings. Defaults: lax/insecure in development, none/secure in production
# (production defaults suit a frontend and backend on different domains).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# Number of reverse proxies in front of the server (Render, Railway, ...). Default 1 in production.
# TRUST_PROXY=1
# bcrypt work factor (4-15). Default 12.
# BCRYPT_COST=12
