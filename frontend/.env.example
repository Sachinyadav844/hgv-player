# Copy to frontend/.env.local for local overrides, or set in your hosting dashboard for production.
# These values are public: they are compiled into the browser bundle. Never put secrets here.

# Public URL of the backend API and Socket.IO server, no trailing slash.
# Leave empty in development: the Vite dev server proxies /api, /health and /socket.io to localhost:4000.
# Leave empty in production only if the backend is served from the same origin as the frontend.
VITE_API_URL=
